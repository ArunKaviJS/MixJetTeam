# ---- Awery ERP API ----
# Single RPC endpoint (HTTP over jRPC). Keep the trailing slash.
AWERY_ERP_API_URL=https://mixjetdev.awery.com/rpc/json/

# Perpetual token issued by the Awery team. Put the REAL value in .env (never commit).
AWERY_ERP_API_BEARER_TOKEN=

# How the token is sent in the Authorization header:
#   bearer -> "Authorization: Bearer <token>"   (default)
#   raw    -> "Authorization: <token>"
AWERY_AUTH_SCHEME=bearer

# HTTP timeout (seconds) for calls to Awery
AWERY_REQUEST_TIMEOUT=30

# ---- This backend service ----
AWERY_BACKEND_HOST=0.0.0.0
AWERY_BACKEND_PORT=8200

# CORS origins for the React frontend (comma separated). * allows all.
AWERY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Optional: pull AI extraction straight from Mongo by _id ----
# Same DB the AI part (../ai) writes to. Leave blank to disable the mongo_id shortcut.
MONGO_URI=
DB_NAME=yellow_chunks
FILE_DETAILS=tb_file_details

# Only list documents tagged as Aviation Permit Requests (see ../ai/gmailmongo.py).
# Set empty to list every document in the collection.
AVIATION_CLUSTER_ID=693901f09d8dbf36a427bd91
